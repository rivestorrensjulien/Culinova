# ─────────────────────────────────────────────────────────────────────────────
# CULINOVA — variables d'environnement
#
# Copier ce fichier en `.env` (à la racine) et en `apps/web/.env.local`, puis
# remplir les valeurs. Ne JAMAIS committer de vraies clés : `.env*` est ignoré
# par git (sauf ce fichier d'exemple). En production, les valeurs sont saisies
# dans les réglages du projet Vercel.
#
# Obligatoires pour lancer le site : DATABASE_URL, BETTER_AUTH_SECRET, BETTER_AUTH_URL.
# Tout le reste est facultatif en développement.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
# Adresse publique du site (sert aux liens dans les e-mails).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Base de données : PostgreSQL (Supabase, région UE) ───────────────────────
# Supabase → Project Settings → Database → Connection string (mode "Transaction").
DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/culinova
# Bases utilisées par les tests (leur nom doit contenir « test » : elles sont vidées à chaque lancement).
DATABASE_URL_TEST=postgresql://postgres:motdepasse@localhost:5432/culinova_test
DATABASE_URL_E2E=postgresql://postgres:motdepasse@localhost:5432/culinova_e2e_test

# Adresse du compte administrateur principal, créé par `pnpm db:seed`.
ADMIN_EMAIL=vous@exemple.fr

# ── Stockage des images : Supabase Storage (J4) ──────────────────────────────
# Supabase → Project Settings → API : « Project URL » et clé « service_role » (secrète).
# Le compartiment privé « recipe-images » est créé automatiquement au premier envoi.
# Sans ces deux valeurs (en développement), les images sont écrites dans un dossier local
# (IMAGE_STORAGE_DIR, par défaut le dossier temporaire du système).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
IMAGE_STORAGE_DIR=

# ── Authentification : Better Auth ───────────────────────────────────────────
# Secret aléatoire d'au moins 32 caractères (ex. : `openssl rand -base64 32`).
# Il chiffre aussi les secrets du second facteur : ne jamais le changer en production
# sans prévoir de refaire l'enrôlement 2FA des administrateurs.
BETTER_AUTH_SECRET=
# Adresse publique du site (sans « / » final).
BETTER_AUTH_URL=http://localhost:3000

# ── Agent de publication (TikTok, Instagram) ─────────────────────────────────
# Clé secrète (au moins 32 caractères, ex. `openssl rand -hex 32`) que l'agent envoie dans
# l'en-tête « Authorization: Bearer <clé> » pour lire /api/agent/publications et y rendre compte.
# Vide : la porte de l'agent est fermée.
AGENT_API_KEY=

# ── Tâches automatiques (Vercel Cron) ───────────────────────────────────────
# Secret aléatoire protégeant la purge quotidienne (/api/cron/purge) : journal de
# sécurité après 12 mois, tentatives de connexion après 7 jours, sessions expirées.
# Vercel l'envoie de lui-même à la tâche planifiée déclarée dans apps/web/vercel.json.
CRON_SECRET=

# ── E-mails : Resend ─────────────────────────────────────────────────────────
# Sans clé (en développement), les e-mails ne partent pas : ils sont écrits dans
# le dossier apps/web/.outbox et le lien s'affiche dans le terminal.
RESEND_API_KEY=
EMAIL_FROM="Culinova <bonjour@exemple.fr>"
# Dossier de la boîte d'envoi locale (facultatif).
EMAIL_OUTBOX_DIR=

# ── IA : texte (Claude) et images (FLUX via fal.ai) ──────────────────────────
# Clé de l'API Claude (console.anthropic.com → API Keys). Sans clé, en
# développement, une IA « factice » répond (recette d'exemple, aucun coût).
ANTHROPIC_API_KEY=
# Uniquement si la clé n'est rattachée à aucun espace de travail (erreur « anthropic-workspace-id ») :
# identifiant wrkspc_… visible dans la Console Claude, Settings → Workspaces, colonne ID.
ANTHROPIC_WORKSPACE_ID=
# Modèle et effort de réflexion pour les recettes (facultatifs).
AI_RECIPE_MODEL=claude-sonnet-5-5
AI_RECIPE_EFFORT=high
# Forcer l'IA factice (tests) : AI_PROVIDER=fake ; délai simulé en ms : AI_FAKE_DELAY_MS.
AI_PROVIDER=
AI_FAKE_DELAY_MS=
# Clé fal.ai (fal.ai → Dashboard → API Keys) pour les photos FLUX.2 [pro]. Sans clé, en
# développement, une image factice (unie) est créée.
FAL_KEY=
# Facultatifs : modèle d'image (vide = fal-ai/flux-2-pro ; ancien : fal-ai/flux-pro/v1.1-ultra) et coût
# estimé d'une image en micro-dollars (120000 = 0,12 $).
AI_IMAGE_MODEL=
IMAGE_COST_USD_MICROS=

# ── Nutrition ────────────────────────────────────────────────────────────────
# La table Ciqual (ANSES) est fournie avec l'application (tâche GitHub « Données Ciqual »).
# Facultatif : clé gratuite USDA FoodData Central (https://fdc.nal.usda.gov/api-key-signup),
# utilisée en complément pour les ingrédients absents de Ciqual.
USDA_FDC_API_KEY=

# ── Tâches longues : Inngest ─────────────────────────────────────────────────
# En production (Vercel), renseigner les deux clés : les générations passent par Inngest.
# Sans elles, la génération s'exécute directement après la réponse (développement).
# Pour tester Inngest en local : `npx inngest-cli@latest dev` et INNGEST_DEV=1.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=

# ── Limitation de débit : Upstash Redis (facultatif, pas encore utilisé) ─────
# En V1, les tentatives de connexion sont limitées via la base de données.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Suivi des erreurs : Sentry ───────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
