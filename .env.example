# ─────────────────────────────────────────────────────────────────────────────
# CULINOVA — variables d'environnement
#
# Copier ce fichier en `.env` (à la racine) et en `apps/web/.env.local`, puis
# remplir les valeurs. Ne JAMAIS committer de vraies clés : `.env*` est ignoré
# par git (sauf ce fichier d'exemple). En production, les valeurs sont saisies
# dans les réglages du projet Vercel.
#
# Obligatoires pour lancer le site : DATABASE_URL, BETTER_AUTH_SECRET, BETTER_AUTH_URL.
# Tout le reste est facultatif en développement.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
# Adresse publique du site (sert aux liens dans les e-mails).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Base de données : PostgreSQL (Supabase, région UE) ───────────────────────
# Supabase → Project Settings → Database → Connection string (mode "Transaction").
DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/culinova
# Bases utilisées par les tests (leur nom doit contenir « test » : elles sont vidées à chaque lancement).
DATABASE_URL_TEST=postgresql://postgres:motdepasse@localhost:5432/culinova_test
DATABASE_URL_E2E=postgresql://postgres:motdepasse@localhost:5432/culinova_e2e_test

# Adresse du compte administrateur principal, créé par `pnpm db:seed`.
ADMIN_EMAIL=vous@exemple.fr

# ── Stockage des images : Supabase Storage (J4) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Authentification : Better Auth ───────────────────────────────────────────
# Secret aléatoire d'au moins 32 caractères (ex. : `openssl rand -base64 32`).
# Il chiffre aussi les secrets du second facteur : ne jamais le changer en production
# sans prévoir de refaire l'enrôlement 2FA des administrateurs.
BETTER_AUTH_SECRET=
# Adresse publique du site (sans « / » final).
BETTER_AUTH_URL=http://localhost:3000

# ── E-mails : Resend ─────────────────────────────────────────────────────────
# Sans clé (en développement), les e-mails ne partent pas : ils sont écrits dans
# le dossier apps/web/.outbox et le lien s'affiche dans le terminal.
RESEND_API_KEY=
EMAIL_FROM="Culinova <bonjour@exemple.fr>"
# Dossier de la boîte d'envoi locale (facultatif).
EMAIL_OUTBOX_DIR=

# ── IA : texte (Claude) et images (FLUX via fal.ai) ──────────────────────────
ANTHROPIC_API_KEY=
# Modèle utilisé pour les recettes (facultatif, valeur par défaut dans packages/ai).
AI_RECIPE_MODEL=claude-sonnet-5-5
FAL_KEY=

# ── Tâches longues : Inngest ─────────────────────────────────────────────────
# En local, `npx inngest-cli@latest dev` suffit : ces clés ne sont utiles qu'en production.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Limitation de débit : Upstash Redis (facultatif, pas encore utilisé) ─────
# En V1, les tentatives de connexion sont limitées via la base de données.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Suivi des erreurs : Sentry ───────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
