{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["dub1"],
  "buildCommand": "pnpm --filter @culinova/db db:deploy && pnpm build",
  "crons": [
    {
      "path": "/api/cron/purge",
      "schedule": "17 3 * * *"
    },
    {
      "path": "/api/cron/reseaux",
      "schedule": "41 5 * * *"
    }
  ]
}
