{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DATABASE_URL_TEST",
    "DATABASE_URL_E2E",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "ADMIN_EMAIL",
    "EMAIL_FROM",
    "EMAIL_OUTBOX_DIR",
    "RESEND_API_KEY",
    "ANTHROPIC_API_KEY",
    "FAL_KEY",
    "INNGEST_*",
    "NEXT_PUBLIC_*",
    "CI",
    "PLAYWRIGHT_BROWSERS_PATH"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
